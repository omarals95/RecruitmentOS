{
  "name": "recruitment-os",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build --webpack",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:storage": "node --test tests/storage*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-local.ts",
    "dev:totp": "tsx scripts/dev-totp.ts",
    "two-step:reset": "tsx scripts/reset-two-step.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "test:local": "tsx scripts/smoke-local.ts",
    "test:live-roles": "tsx scripts/live-role-tests.ts",
    "bench:round-trips": "tsx scripts/benchmark-round-trips.ts",
    "erase:candidate": "tsx scripts/erase-candidate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/credential-provider-web-identity": "3.972.88",
    "@aws-sdk/s3-presigned-post": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@better-auth/core": "1.7.18",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@electric-sql/pglite": "0.5.15",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.11.0",
    "@vercel/oidc": "4.0.7",
    "@vercel/speed-insights": "2.0.0",
    "better-auth": "1.7.18",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.70.0",
    "mammoth": "1.13.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.14",
    "unpdf": "2.1.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "write-excel-file": "4.1.1"
  },
  "type": "module",
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    },
    "eslint": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
