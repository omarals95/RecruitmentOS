# Copy to .env.local for development. Never commit real values.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BOOTSTRAP_OWNER_EMAIL=owner@example.com
# A unique random base64url token (at least 32 random bytes) per environment.
BOOTSTRAP_SETUP_TOKEN=
ALLOW_PUBLIC_SIGNUP=false

# Hosted and production startup refuses unsafe roles, mismatched connections and the
# local/development settings below; deployment still needs review and the owner's decision.
# Use separate nonowner roles against the same database; never put owner credentials here.
DATABASE_URL=
IDENTITY_DATABASE_URL=
# Owner connection used ONLY by `npm run db:migrate`; do not expose to runtime.
MIGRATION_DATABASE_URL=
# Server-only base64url key (at least 32 random bytes), separate per environment; npm run db:migrate also needs it.
TENANT_CONTEXT_SIGNING_KEY=

# Email verification, invitations and password resets (production required).
RESEND_API_KEY=
EMAIL_FROM=RecruitmentOS <recruitment@example.com>
# Development only: links appear in your local terminal; never enable in production.
DEV_MAIL_MODE=console

# Optional providers. Set callback URLs as described in docs/deployment.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Private Vercel Blob CV storage (the default). Hosted environments authenticate with the
# request's Vercel OIDC token and must not set BLOB_READ_WRITE_TOKEN: Blob is refused while it
# is present, even empty. Use a separate private store per environment. Locally Blob is not set up.
CV_STORAGE_PROVIDER=blob
BLOB_STORE_ID=

# Vercel Speed Insights (free tier) share of page views reported, from 0 to 1. Read at build
# time; unset or invalid means 1.0. Reporting runs only in production builds.
NEXT_PUBLIC_SPEED_INSIGHTS_SAMPLE_RATE=1.0

# Legacy, dormant S3 option (DEC-01, 7 November 2026): used only with CV_STORAGE_PROVIDER=s3,
# never for hosted environments.
AWS_REGION=me-central-1
S3_BUCKET_NAME=
AWS_ROLE_ARN=
# Explicit server-only local IAM alternative; no default profile lookup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Explicit local development only. Remove these from production environment.
DATABASE_MODE=
ALLOW_LOCAL_DB=false
PGLITE_DATA_DIR=.local/database
DEV_SEED_PASSWORD=
# Base32 authenticator key of the fictional seed owner, who uses two-step sign-in. Leave empty and
# npm run db:seed prints one to add here; npm run dev:totp prints the current code. Local only.
DEV_SEED_TOTP_KEY=
